<%- include('partials/header') %>

<!-- Banner Section with Floating Student Background -->
<div class="hero-banner text-center position-relative">
    <div class="floating-bg">
        <img src="/images/student1.jpg" class="floating-img img-1" alt="Graduated Student">
        <img src="/images/student2.jpg" class="floating-img img-2" alt="Graduated Student">
        <img src="/images/student3.jpg" class="floating-img img-3" alt="Graduated Student">
        <img src="/images/student4.jpg" class="floating-img img-4" alt="Graduated Student">
    </div>
    <div class="container hero-content">
        <h1 class="display-4 fw-bold mb-3">Welcome To Havard Hub</h1>
        <p class="lead max-w-600 mx-auto text-light opacity-90">
            Build career-ready skills in Tech, AI Engineering, Creative Media, and Skilled Vocational Trades with practical hands-on training.
        </p>
        <div class="mt-4">
            <a href="/courses" class="btn btn-warning btn-lg me-2 fw-bold text-dark"><i class="bi bi-book me-1"></i> Explore Courses</a>
            <% if (!user) { %>
                <a href="/signup" class="btn btn-outline-light btn-lg"><i class="bi bi-person-plus me-1"></i> Get Started</a>
            <% } %>
        </div>
    </div>
</div>

