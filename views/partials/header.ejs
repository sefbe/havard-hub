<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Havard Hub - Empowerment & Skill Acquisition</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top shadow-sm">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center fw-bold" href="/">
      <img src="/images/logo.png" alt="Havard Hub Logo" class="brand-logo me-2">
      HAVARD HUB
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto align-items-center">
        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link" href="/courses">Courses</a></li>
        <li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
        <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <li class="nav-item"><a class="nav-link text-warning fw-bold" href="/admin"><i class="bi bi-shield-lock"></i> Admin Panel</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link text-info fw-bold" href="/profile"><i class="bi bi-person-circle"></i> My Profile</a></li>
          <% } %>
          <li class="nav-item ms-2">
            <a class="btn btn-outline-danger btn-sm px-3" href="/logout"><i class="bi bi-power"></i> Disconnect</a>
          </li>
        <% } else { %>
          <li class="nav-item ms-2"><a class="btn btn-outline-light btn-sm px-3" href="/login">Login</a></li>
          <li class="nav-item ms-1"><a class="btn btn-warning btn-sm px-3 fw-bold" href="/signup">Sign Up</a></li>
        <% } %>
      </ul>
    </div>
  </div>
</nav>
