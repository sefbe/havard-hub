<%- include('partials/header') %>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Admin Management Console</h2>
        <span class="badge bg-warning text-dark px-3 py-2 fs-6">Administrator Portal</span>
    </div>

    <div class="row g-4">
        <!-- Add and Manage Courses -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3"><i class="bi bi-journal-plus text-primary me-2"></i>Add New Course</h5>
                    <form action="/admin/course/add" method="POST" class="mb-4">
                        <div class="mb-2">
                            <input type="text" name="title" class="form-control" placeholder="Course Title (e.g., Cloud Computing)" required>
                        </div>
                        <div class="mb-2">
                            <input type="text" name="category" class="form-control" placeholder="Category (e.g., Technology)" required>
                        </div>
                        <button class="btn btn-success w-100 fw-bold" type="submit">Add Course</button>
                    </form>

                    <h5 class="fw-bold mb-3"><i class="bi bi-book me-2"></i>All Available Courses (<%= courses.length %>)</h5>
                    <div class="table-responsive" style="max-height: 380px; overflow-y: auto;">
                        <table class="table table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% courses.forEach(c => { %>
                                    <tr>
                                        <td><%= c.id %></td>
                                        <td class="fw-semibold"><%= c.title %></td>
                                        <td><span class="badge bg-secondary"><%= c.category %></span></td>
                                        <td>
                                            <form action="/admin/course/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this course?');">
                                                <input type="hidden" name="course_id" value="<%= c.id %>">
                                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Student & Enrollment Overview -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="fw-bold mb-3"><i class="bi bi-people me-2"></i>Registered Students (<%= students.length %>)</h5>
                    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                        <table class="table table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Student</th>
                                    <th>Enrolled Courses</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% students.forEach(s => { %>
                                    <tr>
                                        <td>
                                            <div class="fw-bold"><%= s.name %></div>
                                            <small class="text-muted"><%= s.email %></small>
                                        </td>
                                        <td>
                                            <% if (s.enrolled_courses) { %>
                                                <small class="badge bg-info text-dark text-wrap"><%= s.enrolled_courses %></small>
                                            <% } else { %>
                                                <small class="text-muted">No enrollments</small>
                                            <% } %>
                                        </td>
                                        <td>
                                            <form action="/admin/student/delete" method="POST" class="d-inline" onsubmit="return confirm('Permanently delete this student account?');">
                                                <input type="hidden" name="student_id" value="<%= s.id %>">
                                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
